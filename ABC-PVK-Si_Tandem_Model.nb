Cell[CellGroupData[{

Cell["Tandem solar cell model", "Subchapter",
 CellChangeTimes->{{3.687160883964138*^9, 3.687160895524294*^9}, {
   3.695638341429324*^9, 3.6956383576523237`*^9}, {3.69613609636379*^9, 
   3.6961361156967897`*^9}, 3.6966712853816485`*^9, {3.696673734584544*^9, 
   3.6966737547055564`*^9}, {3.700908815174469*^9, 3.700908815510503*^9}, {
   3.7009088697209234`*^9, 3.7009088763135824`*^9}, {3.700910466621293*^9, 
   3.700910468091379*^9}, {3.702883412154811*^9, 3.7028834134008107`*^9}, {
   3.710742382086376*^9, 
   3.710742384789647*^9}},ExpressionUUID->"23feb49a-08d0-45ae-9368-\
7d518a4262b0"],

Cell["\<\
To model the tandem solar cells we assume a perfect reflector on the back \
side of the silicon bottom cell and no selective reflector between the \
perovskite top cell and the Si bottom cell.For simplicity we neglect \
reabsorption of luminescence between the two subcells.\
\>", "Text",
 CellChangeTimes->{{3.7107420559367647`*^9, 3.710742055937765*^9}, 
   3.710742127779948*^9, {3.7107422595521245`*^9, 
   3.7107422721213813`*^9}},ExpressionUUID->"4e884bc5-d5a6-4639-95d3-\
f535e1b9a8fa"],

Cell[CellGroupData[{

Cell["Current-matched series tandem", "Subsection",
 CellChangeTimes->{{3.6998518049149737`*^9, 3.699851862407974*^9}, {
  3.71074241582375*^9, 
  3.710742436655833*^9}},ExpressionUUID->"59777e7a-fe59-4f36-985b-\
b42152e85b5b"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"(*", " ", 
    RowBox[{"Realistic", " ", "series", " ", "tandem", " ", "Limit"}], " ", 
    "*)"}], "Text"], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SQSeries", "[", 
     RowBox[{"Eg1_", ",", "Eg2_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Quiet", "[", 
      RowBox[{"{", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Make", " ", "JV", " ", "characteristic", " ", "of", " ", "Si", " ", 
         "bottom", " ", "cell"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"dSi", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"v1", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"FindRoot", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Il1", "\[Equal]", 
                 RowBox[{"jgSitandemthin", "-", "\[IndentingNewLine]", 
                  RowBox[{"JRSi", "[", 
                   RowBox[{"v1", ",", "Il1", ",", "1", ",", "RsSi"}], "]"}], "-",
                   "\[IndentingNewLine]", 
                  RowBox[{"JRAuger", "[", 
                   RowBox[{"v1", ",", "Il1", ",", "RsSi"}], "]"}], "-", " ", 
                  "\[IndentingNewLine]", 
                  RowBox[{"JRnonSi", "[", 
                   RowBox[{"v1", ",", "Il1", ",", "RsSi"}], "]"}], "-", 
                  "\[IndentingNewLine]", 
                  RowBox[{"Resistance", "[", 
                   RowBox[{"v1", ",", "Il1", ",", "RsSi", ",", "RshSi"}], 
                   "]"}]}]}], "\[IndentingNewLine]", ",", 
                RowBox[{"{", 
                 RowBox[{"Il1", ",", "0"}], "}"}]}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"v1", ",", "0", ",", 
             RowBox[{"Eg1", "-", "0.1"}], ",", ".001"}], "}"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"ivSi", "=", 
         RowBox[{"Interpolation", "[", "dSi", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Calculate", " ", "Voc", " ", "and", " ", "Jsc", " ", "of", " ", 
          "Si", " ", "bottom", " ", "cell"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"vocSi", "=", 
         RowBox[{
          RowBox[{"FindRoot", "[", 
           RowBox[{
            RowBox[{"ivSi", "[", "v", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"v", ",", 
              RowBox[{"Eg1", "-", "0.2"}]}], "}"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"jscSi", " ", "=", " ", 
         RowBox[{"ivSi", "[", "0", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Make", " ", "JV", " ", "characteristic", " ", "of", " ", 
          "perovskite", " ", "top", " ", "cell"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"dPerovskite", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"v2", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"FindRoot", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Il2", "\[Equal]", 
                 RowBox[{"jgPerovskitetandemthin", "-", "\[IndentingNewLine]", 
                  RowBox[{"JRPerovskite", "[", 
                   RowBox[{"v2", ",", "Il2", ",", "2", ",", "RsPerovskite"}], 
                   "]"}], "-", "\[IndentingNewLine]", 
                  RowBox[{"JRnonPerovskite", "[", 
                   RowBox[{"v2", ",", "Il2", ",", "RsPerovskite"}], "]"}], "-",
                   "\[IndentingNewLine]", 
                  RowBox[{"Resistance", "[", 
                   RowBox[{
                   "v2", ",", "Il2", ",", "RsPerovskite", ",", 
