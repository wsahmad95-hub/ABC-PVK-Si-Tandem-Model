           RowBox[{"{", 
            RowBox[{"v1", ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"FindRoot", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Il1", "\[Equal]", 
                 RowBox[{"jgSitandem", "-", "\[IndentingNewLine]", 
                  RowBox[{"JRSi", "[", 
                   RowBox[{"v1", ",", "Il1", ",", "1", ",", "RsSi"}], "]"}], "-",
                   "\[IndentingNewLine]", 
                  RowBox[{"JRAuger", "[", 
                   RowBox[{"v1", ",", "Il1", ",", "RsSi"}], "]"}], "-", " ", 
                  "\[IndentingNewLine]", 
