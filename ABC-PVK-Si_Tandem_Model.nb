           ",", "\"\<ThreeTerminalMPP\>\"", ",", "\"\<FourTerminalMPP\>\""}], 
          "}"}]}], ";", "\n", "  ", 
        RowBox[{"missing", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"required", ",", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"KeyExistsQ", "[", 
              RowBox[{"report", ",", "#"}], "]"}]}], "&"}]}], "]"}]}], ";", 
        "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"missing", "=!=", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Incomplete report: \>\"", ",", "missing"}], "]"}], ";", 
           RowBox[{"Return", "[", 
            RowBox[{"Failure", "[", 
             RowBox[{"\"\<IncompleteReport\>\"", ",", 
              RowBox[{"<|", 
               RowBox[{"\"\<MissingKeys\>\"", "->", "missing"}], "|>"}]}], 
             "]"}], "]"}]}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"Print", "[", 
         RowBox[{"report", "[", "\"\<Figure\>\"", "]"}], "]"}], ";", "\n", 
        "  ", 
        RowBox[{"tandemMetrics", "=", 
         RowBox[{"MakeTandemMetricsTable", "[", "report", "]"}]}], ";", "\n", 
        "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AssociationQ", "[", "tandemMetrics", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<Table calculation failed: \>\"", ",", 
             "tandemMetrics"}], "]"}], ";", 
           RowBox[{"Return", "[", "tandemMetrics", "]"}]}]}], "]"}], ";", 
        "\n", "  ", 
        RowBox[{"Print", "[", 
         RowBox[{"tandemMetrics", "[", "\"\<Table\>\"", "]"}], "]"}], ";", 
        "\n", "  ", 
        RowBox[{"root", "=", 
         RowBox[{"ResolveTandemOutput", "[", "requestedRoot", "]"}]}], ";", 
        "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FailureQ", "[", "root", "]"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<Results displayed, but export path is invalid: \>\"",
              ",", "root"}], "]"}], ";", 
           RowBox[{"Return", "[", "root", "]"}]}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<EXPORT ROOT: \>\"", ",", "root"}], "]"}], ";", "\n", 
        "  ", 
        RowBox[{"jvExport", "=", 
         RowBox[{"ExportTandemJV", "[", 
          RowBox[{"report", ",", "root", ",", 
           RowBox[{"\"\<Formats\>\"", "->", "formats"}]}], "]"}]}], ";", "\n",
         "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"AssociationQ", "[", "jvExport", "]"}], ",", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<J-V CSV files saved and verified: \>\"", ",", 
            RowBox[{"jvExport", "[", "\"\<CSVDirectory\>\"", "]"}]}], "]"}], ",",
           "\n", "    ", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<J-V export failed: \>\"", ",", "jvExport"}], "]"}]}], 
         "]"}], ";", "\n", "  ", 
        RowBox[{"metricParent", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"AssociationQ", "[", "jvExport", "]"}], ",", 
           RowBox[{"jvExport", "[", "\"\<CSVDirectory\>\"", "]"}], ",", 
           "root"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"tandemMetricsExport", "=", 
         RowBox[{"ExportTandemMetrics", "[", 
          RowBox[{"tandemMetrics", ",", "metricParent"}], "]"}]}], ";", "\n", 
        "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"AssociationQ", "[", "tandemMetricsExport", "]"}], ",", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<TABLE CSV files saved and verified: \>\"", ",", 
            RowBox[{"tandemMetricsExport", "[", "\"\<Directory\>\"", "]"}]}], 
           "]"}], ",", "\n", "    ", 
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<Table export failed: \>\"", ",", 
            "tandemMetricsExport"}], "]"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"snapshotPath", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"AssociationQ", "[", "jvExport", "]"}], ",", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"jvExport", "[", "\"\<Directory\>\"", "]"}], 
              ",", "\"\<Calculated_Tandem_Report.wxf\>\""}], "}"}], "]"}], ",",
            "\n", "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"AssociationQ", "[", "tandemMetricsExport", "]"}], ",", 
             RowBox[{"FileNameJoin", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                "tandemMetricsExport", "[", "\"\<Directory\>\"", "]"}], 
                ",", "\"\<Calculated_Tandem_Report.wxf\>\""}], "}"}], "]"}], ",",
              "$Failed"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"snapshotResult", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"StringQ", "[", "snapshotPath", "]"}], ",", 
           RowBox[{"Quiet", "[", 
            RowBox[{"Check", "[", 
             RowBox[{
              RowBox[{"Export", "[", 
               RowBox[{"snapshotPath", ",", "report", ",", "\"\<WXF\>\""}], 
               "]"}], ",", "$Failed"}], "]"}], "]"}], ",", "$Failed"}], 
          "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"StringQ", "[", "snapshotResult", "]"}], ",", 
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<Saved calculated report (for reopening/re-export): \>\
\"", ",", "snapshotPath"}], "]"}], ",", "\n", "    ", 
          RowBox[{
          "Print", 
           "[", "\"\<The calculated report could not be saved to disk. Keep \
this Mathematica session open to retain the results.\>\"", "]"}]}], "]"}], ";",
         "\n", "  ", 
        RowBox[{"ok", "=", 
         RowBox[{
          RowBox[{"AssociationQ", "[", "jvExport", "]"}], "&&", 
          RowBox[{"AssociationQ", "[", "tandemMetricsExport", "]"}], "&&", 
          RowBox[{"StringQ", "[", "snapshotResult", "]"}]}]}], ";", "\n", 
        "  ", 
        RowBox[{"If", "[", 
         RowBox[{"ok", ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<COMPLETE: J-V plots, performance tables, and all \
CSV exports are ready.\>\"", ",", "13", ",", "Bold"}], "]"}], "]"}], ";", 
           "\n", "    ", 
           RowBox[{"Print", "[", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"folder", "=", 
                RowBox[{"jvExport", "[", "\"\<Directory\>\"", "]"}]}], "}"}], 
              ",", 
              RowBox[{"Button", "[", 
               RowBox[{"\"\<Open this run's output folder\>\"", ",", 
                RowBox[{"SystemOpen", "[", "folder", "]"}], ",", 
                RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}]}], "]"}], 
            "]"}], ";", "\n", "    ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Status\>\"", "->", "\"\<Complete\>\""}], ",", 
             RowBox[{"\"\<OutputRoot\>\"", "->", "root"}], ",", 
             RowBox[{"\"\<JVExport\>\"", "->", "jvExport"}], ",", "\n", 
             "      ", 
             RowBox[{"\"\<MetricsExport\>\"", "->", "tandemMetricsExport"}], ",", 
             RowBox[{"\"\<SavedReport\>\"", "->", "snapshotPath"}]}], 
            "|>"}]}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{
           "Print", 
            "[", "\"\<EXPORT INCOMPLETE. The calculated plots and tables \
above remain available; review the export error details.\>\"", "]"}], ";", 
           "\n", "    ", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<ExportIncomplete\>\"", ",", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<OutputRoot\>\"", "->", "root"}], ",", 
               RowBox[{"\"\<JVExport\>\"", "->", "jvExport"}], ",", "\n", 
               "      ", 
               RowBox[{"\"\<MetricsExport\>\"", "->", "tandemMetricsExport"}],
                ",", 
               RowBox[{"\"\<SavedReport\>\"", "->", "snapshotResult"}]}], 
              "|>"}]}], "]"}]}]}], "\n", "  ", "]"}]}]}], "\n", "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"RunTandemWorkflow", "[", 
      RowBox[{"requestedRoot_", ",", "settings_List", ",", "formats_List"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "ready", "}"}], ",", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "Explicitly", " ", "calculate", " ", "a", " ", "NEW", " ", 
          "report"}], ";", " ", 
         RowBox[{
         "never", " ", "depend", " ", "on", " ", "a", " ", "previous", " ", 
          RowBox[{"jvReport", "."}]}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{
        RowBox[{"jvReport", "=", "$Failed"}], ";", 
        RowBox[{"jvExport", "=", "$Failed"}], ";", 
        RowBox[{"tandemMetrics", "=", "$Failed"}], ";", 
        RowBox[{"tandemMetricsExport", "=", "$Failed"}], ";", "\n", "  ", 
        RowBox[{"ready", "=", 
         RowBox[{"CheckTandemModelReady", "[", "settings", "]"}]}], ";", "\n",
         "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FailureQ", "[", "ready", "]"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<MODEL NOT READY: \>\"", ",", "ready"}], "]"}], ";", 
           RowBox[{"Return", "[", "ready", "]"}]}]}], "]"}], ";", "\n", "  ", 
        
        RowBox[{
        "Print", 
         "[", "\"\<Calculating all four tandem J-V characteristics from the \
current model inputs...\>\"", "]"}], ";", "\n", "  ", 
        RowBox[{"jvReport", "=", 
         RowBox[{"CheckAbort", "[", 
          RowBox[{
           RowBox[{"MakeTandemJVPlots", "[", 
            RowBox[{"Sequence", "@@", "settings"}], "]"}], ",", "\n", "    ", 
           
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<Aborted\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<MessageTemplate\>\"", 
               "->", "\"\<The J-V calculation was interrupted.\>\""}], 
              "|>"}]}], "]"}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AssociationQ", "[", "jvReport", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<J-V CALCULATION FAILED: \>\"", ",", "jvReport"}], 
            "]"}], ";", 
           RowBox[{"Return", "[", "jvReport", "]"}]}]}], "]"}], ";", "\n", 
        "  ", 
        RowBox[{"ExportCurrentTandemResults", "[", 
         RowBox[{"jvReport", ",", "requestedRoot", ",", "formats"}], 
         "]"}]}]}], "\n", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"RUN", ".", " ", "Changing"}], " ", "the", " ", "output", " ", 
     "folder", " ", "does", " ", "not", " ", "remove", " ", "or", " ", "skip",
      " ", "this", " ", 
     RowBox[{"calculation", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"tandemRunStatus", "=", 
     RowBox[{"RunTandemWorkflow", "[", 
      RowBox[{
      "tandemOutputRoot", ",", "tandemJVSettings", ",", 
       "tandemFigureFormats"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"OPTIONAL", ":", " ", 
      RowBox[{"in", " ", "a", " ", "later", " ", "Input", " ", "cell"}]}], ",",
      " ", 
     RowBox[{
      RowBox[{
       RowBox[{"re", "-", 
        RowBox[{"export", " ", "without", " ", 
         RowBox[{"recalculating", ":", "\n", "   ", "tandemRunStatus"}]}]}], 
       " ", "=", " ", 
       RowBox[{"ExportCurrentTandemResults", "[", 
        RowBox[{"jvReport", ",", "\"\<D:/Tandem Results\>\""}], "]"}]}], ";", 
      "\n", "\n", "   ", 
      RowBox[{"After", " ", "restarting", " ", "Mathematica"}]}], ",", " ", 
     RowBox[{
     "evaluate", " ", "this", " ", "file", " ", "to", " ", "load", " ", "its",
       " ", "functions"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
         "then", "\n", "   ", "choose", " ", "your", " ", "own", " ", 
          RowBox[{"saved", " ", ".", "wxf"}], " ", "report", " ", "and", " ", 
          "re"}], "-", 
         RowBox[{"export", " ", "it", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"no", " ", "physical"}], "-", 
            RowBox[{"model", " ", "rerun"}]}], ")"}]}]}], ":", "\n", "   ", 
        "reportFile"}], " ", "=", " ", 
       RowBox[{"SystemDialogInput", "[", "\"\<FileOpen\>\"", "]"}]}], ";", 
      "\n", "   ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"StringQ", "[", "reportFile", "]"}], ",", "\n", "     ", 
        RowBox[{
         RowBox[{"jvReport", " ", "=", " ", 
          RowBox[{"Import", "[", 
           RowBox[{"reportFile", ",", "\"\<WXF\>\""}], "]"}]}], ";", "\n", 
         "     ", 
         RowBox[{"tandemRunStatus", " ", "=", " ", 
          RowBox[{"ExportCurrentTandemResults", "[", 
           RowBox[{"jvReport", ",", "\"\<D:/Tandem Results\>\""}], "]"}]}], 
         ";"}]}], "\n", "   ", "]"}], ";"}]}], "\n", "*)"}], 
   "\n"}]}]], "Input",
