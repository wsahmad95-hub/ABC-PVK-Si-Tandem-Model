                    RowBox[{
                    RowBox[{
                    RowBox[{"VectorQ", "[", 
                    RowBox[{"#", ",", "NumericQ"}], "]"}], "&&", 
                    RowBox[{
                    RowBox[{"Length", "[", "#", "]"}], "==", "2"}]}], "&"}]}],
                     "]"}], ",", "First"}], "]"}], ",", "First"}], "]"}]}], ";",
               "\n", "    ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", "d", "]"}], "<", "2"}], ",", 
                RowBox[{"Throw", "[", 
                 RowBox[{
                  RowBox[{"Failure", "[", 
                   RowBox[{"\"\<Curve\>\"", ",", 
                    RowBox[{"<|", 
                    
                    RowBox[{"\"\<MessageTemplate\>\"", 
                    "->", "\"\<A J-V curve has fewer than two numeric points.\
\>\""}], "|>"}]}], "]"}], ",", "\"\<Metrics\>\""}], "]"}]}], "]"}], ";", "\n",
               "    ", 
              RowBox[{"iv", "=", 
               RowBox[{"Interpolation", "[", 
                RowBox[{"d", ",", 
                 RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
              "\n", "    ", 
              RowBox[{"at0", "=", 
               RowBox[{"Select", "[", 
                RowBox[{"d", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "<", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", "9"}]}]}], "&"}]}], "]"}]}], ";", "\n", 
              "    ", 
              RowBox[{"jsc", "=", 
               RowBox[{"Which", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Length", "[", "at0", "]"}], ">", "0"}], ",", 
                 RowBox[{
                  RowBox[{"First", "[", "at0", "]"}], "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ",", "\n", "      ", 
                 RowBox[{
                  RowBox[{"d", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "<", "0", "<", 
                  RowBox[{"d", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ",", 
                 RowBox[{"iv", "[", "0.", "]"}], ",", "True", ",", 
                 RowBox[{
                 "Missing", "[", "\"\<ShortCircuitOutsideSweep\>\"", "]"}]}], 
                "]"}]}], ";", "\n", "    ", 
              RowBox[{"zeros", "=", 
               RowBox[{"Select", "[", 
                RowBox[{"d", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ">=", "0"}], "&&", 
                   RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "8"}]}]}]}], "&"}]}], "]"}]}], ";", "\n", 
              "    ", 
              RowBox[{"crossings", "=", 
               RowBox[{"Cases", "[", 
                RowBox[{
                 RowBox[{"Partition", "[", 
                  RowBox[{"d", ",", "2", ",", "1"}], "]"}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"v1_", ",", "j1_"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"v2_", ",", "j2_"}], "}"}]}], "}"}], " ", "/;", 
                   "\n", "      ", 
                   RowBox[{
                    RowBox[{"v2", ">=", "0"}], "&&", 
                    RowBox[{"j1", ">", "0"}], "&&", 
                    RowBox[{"j2", "<", "0"}]}]}], " ", ":>", " ", 
                  RowBox[{"v1", "-", 
                   RowBox[{"j1", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"v2", "-", "v1"}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"j2", "-", "j1"}], ")"}]}]}]}]}]}], "]"}]}], ";", 
              "\n", "    ", 
              RowBox[{"voc", "=", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "zeros", "]"}], "+", 
                   RowBox[{"Length", "[", "crossings", "]"}]}], ">", "0"}], ",",
                  "\n", "      ", 
                 RowBox[{"Min", "[", 
                  RowBox[{"Join", "[", 
                   RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"zeros", "==", 
                    RowBox[{"{", "}"}]}], ",", 
                    RowBox[{"{", "}"}], ",", 
                    RowBox[{"zeros", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}], ",", 
                    "crossings"}], "]"}], "]"}], ",", 
                 RowBox[{
                 "Missing", "[", "\"\<OpenCircuitOutsideSweep\>\"", "]"}]}], 
                "]"}]}], ";", "\n", "    ", 
              RowBox[{"candidates", "=", 
               RowBox[{"Select", "[", 
                RowBox[{"d", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ">=", "0"}], "&&", 
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ">=", "0"}]}], "&"}]}], 
                "]"}]}], ";", "\n", "    ", 
              RowBox[{"Do", "[", "\n", "      ", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x1", ",", "y1"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"x2", ",", "y2"}], "}"}]}], "}"}], "=", "pair"}], 
                 ";", 
                 RowBox[{"a", "=", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"y2", "-", "y1"}], ")"}], "/", 
                   RowBox[{"(", 
                    RowBox[{"x2", "-", "x1"}], ")"}]}]}], ";", 
                 RowBox[{"b", "=", 
                  RowBox[{"y1", "-", 
                   RowBox[{"a", " ", "x1"}]}]}], ";", "\n", "      ", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"a", "<", "0"}], ",", 
                   RowBox[{
                    RowBox[{"x0", "=", 
                    RowBox[{
                    RowBox[{"-", "b"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"2", " ", "a"}], ")"}]}]}], ";", "\n", "        ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{"0.", ",", "x1"}], "]"}], "<=", "x0", "<=", 
                    "x2"}], " ", "&&", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"a", " ", "x0"}], "+", "b"}], ">=", "0"}]}], ",", 
                    "\n", "          ", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"candidates", ",", 
                    RowBox[{"{", 
                    RowBox[{"x0", ",", 
                    RowBox[{
                    RowBox[{"a", " ", "x0"}], "+", "b"}]}], "}"}]}], "]"}]}], 
                    "]"}]}]}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"pair", ",", 
                  RowBox[{"Partition", "[", 
                   RowBox[{"d", ",", "2", ",", "1"}], "]"}]}], "}"}]}], "]"}],
               ";", "\n", "    ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"candidates", "==", 
                 RowBox[{"{", "}"}]}], ",", 
                RowBox[{"Throw", "[", 
                 RowBox[{
                  RowBox[{"Failure", "[", 
                   RowBox[{"\"\<GeneratingCurve\>\"", ",", 
                    RowBox[{"<|", 
                    
                    RowBox[{"\"\<MessageTemplate\>\"", 
                    "->", "\"\<No generating points are available for a \
metric calculation.\>\""}], "|>"}]}], "]"}], ",", "\"\<Metrics\>\""}], 
                 "]"}]}], "]"}], ";", "\n", "    ", 
              RowBox[{"best", "=", 
               RowBox[{"First", "[", 
                RowBox[{"MaximalBy", "[", 
                 RowBox[{"candidates", ",", 
                  RowBox[{
                   RowBox[{"Times", "@@", "#"}], "&"}]}], "]"}], "]"}]}], ";",
               "\n", "    ", 
              RowBox[{"pmax", "=", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"knownPmax", "===", "Automatic"}], ",", 
                 RowBox[{"10", " ", 
                  RowBox[{"Times", "@@", "best"}]}], ",", 
                 RowBox[{"N", "[", "knownPmax", "]"}]}], "]"}]}], ";", "\n", 
              "    ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"!", 
                  RowBox[{"NumericQ", "[", "pmax", "]"}]}], "||", 
                 RowBox[{"!", 
                  RowBox[{"TrueQ", "[", 
                   RowBox[{"pmax", ">=", "0"}], "]"}]}]}], ",", 
                RowBox[{"Throw", "[", 
                 RowBox[{
                  RowBox[{"Failure", "[", 
                   RowBox[{"\"\<MaximumPower\>\"", ",", 
                    RowBox[{"<|", 
                    
                    RowBox[{"\"\<MessageTemplate\>\"", 
                    "->", "\"\<Invalid maximum power in the saved \
report.\>\""}], "|>"}]}], "]"}], ",", "\"\<Metrics\>\""}], "]"}]}], "]"}], ";",
               "\n", "    ", 
              RowBox[{"ff", "=", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"NumericQ", "[", "voc", "]"}], "&&", 
                  RowBox[{"NumericQ", "[", "jsc", "]"}], "&&", 
                  RowBox[{"TrueQ", "[", 
                   RowBox[{
                    RowBox[{"voc", " ", "jsc"}], ">", "0"}], "]"}]}], ",", 
                 "\n", "      ", 
                 RowBox[{"100", " ", 
                  RowBox[{"pmax", "/", 
                   RowBox[{"(", 
                    RowBox[{"10", " ", "voc", " ", "jsc"}], ")"}]}]}], ",", 
                 RowBox[{
                 "Missing", "[", "\"\<EndpointUnavailable\>\"", "]"}]}], 
                "]"}]}], ";", "\n", "    ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"MissingQ", "[", "jsc", "]"}], ",", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{
                 "status", 
                  ",", "\"\<Jsc unavailable: sweep does not include \
V=0\>\""}], "]"}]}], "]"}], ";", "\n", "    ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"MissingQ", "[", "voc", "]"}], ",", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{
                 "status", 
                  ",", "\"\<Voc unavailable: sweep does not include \
J=0\>\""}], "]"}]}], "]"}], ";", "\n", "    ", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Voc_V\>\"", "->", "voc"}], ",", 
                RowBox[{"\"\<Jsc_mA_cm2\>\"", "->", "jsc"}], ",", 
                RowBox[{"\"\<FF_percent\>\"", "->", "ff"}], ",", "\n", 
                "      ", 
                RowBox[{"\"\<Pmax_W_m2\>\"", "->", "pmax"}], ",", 
                RowBox[{"\"\<PCE_percent\>\"", "->", 
                 RowBox[{"100", " ", 
                  RowBox[{"pmax", "/", "g"}]}]}], ",", "\n", "      ", 
                RowBox[{"\"\<Status\>\"", "->", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"status", "==", 
                    RowBox[{"{", "}"}]}], ",", "\"\<Endpoints available\>\"", 
                   ",", 
                   RowBox[{"StringRiffle", "[", 
                    RowBox[{"status", ",", "\"\<; \>\""}], "]"}]}], "]"}]}]}],
                "|>"}]}]}], "\n", "  ", "]"}]}], ";", "\n", "  ", 
          RowBox[{"m2", "=", 
           RowBox[{"curve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Rest", "[", 
               RowBox[{"tab", "[", "\"\<Series2T_Overall_JV\>\"", "]"}], 
               "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
             RowBox[{"summ", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "]"}]}], ";", "\n", 
          "  ", 
          RowBox[{"mm", "=", 
           RowBox[{"curve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Rest", "[", 
               RowBox[{
               "tab", "[", "\"\<VMM_Branches_and_Overall_JV\>\"", "]"}], 
               "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "4"}], "}"}]}], "]"}], "]"}], ",", 
             RowBox[{"summ", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "2"}], "]"}], "]"}]}], "]"}]}], ";", "\n", 
          "  ", 
          RowBox[{"m3p", "=", 
           RowBox[{"curve", "[", 
            RowBox[{
             RowBox[{"Rest", "[", 
              RowBox[{
              "tab", "[", "\"\<ThreeTerminal_TopPort_Sweep\>\"", "]"}], "]"}],
              "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], "]"}]}], ";", 
          "\n", "  ", 
          RowBox[{"m3s", "=", 
           RowBox[{"curve", "[", 
            RowBox[{
             RowBox[{"Rest", "[", 
              RowBox[{
              "tab", "[", "\"\<ThreeTerminal_BottomPort_Sweep\>\"", "]"}], 
              "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", 
               RowBox[{"{", 
                RowBox[{"2", ",", "4"}], "}"}]}], "]"}], "]"}], "]"}]}], ";", 
          "\n", "  ", 
          RowBox[{"m4p", "=", 
           RowBox[{"curve", "[", 
            RowBox[{
             RowBox[{"Rest", "[", 
              RowBox[{"tab", "[", "\"\<FourTerminal_Top_JV\>\"", "]"}], "]"}],
              ",", 
             RowBox[{
              RowBox[{
               RowBox[{"report", "[", "\"\<FourTerminalMPP\>\"", "]"}], 
               "[", "\"\<Pe_V_and_P_W_m2\>\"", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"m4s", "=", 
           RowBox[{"curve", "[", 
            RowBox[{
             RowBox[{"Rest", "[", 
              RowBox[{"tab", "[", "\"\<FourTerminal_Bottom_JV\>\"", "]"}], 
              "]"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"report", "[", "\"\<FourTerminalMPP\>\"", "]"}], 
               "[", "\"\<Si_V_and_P_W_m2\>\"", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{
           RowBox[{"row", "[", 
            RowBox[{"name_", ",", "m_"}], "]"}], " ", ":=", " ", 
           RowBox[{"{", 
            RowBox[{"name", ",", 
             RowBox[{"m", "[", "\"\<Voc_V\>\"", "]"}], ",", 
             RowBox[{"m", "[", "\"\<Jsc_mA_cm2\>\"", "]"}], ",", 
             RowBox[{"m", "[", "\"\<FF_percent\>\"", "]"}], ",", 
             RowBox[{"m", "[", "\"\<PCE_percent\>\"", "]"}]}], "}"}]}], ";", 
          "\n", "  ", 
          RowBox[{"headers", "=", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Configuration\>\"", ",", "\"\<Voc (V)\>\"", 
             ",", "\"\<Jsc (mA/cm^2)\>\"", ",", "\"\<FF (%)\>\"", 
             ",", "\"\<PCE (%)\>\""}], "}"}]}], ";", "\n", "  ", 
          RowBox[{"summaryRows", "=", 
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"{", "\n", "    ", 
              RowBox[{
               RowBox[{"row", "[", 
                RowBox[{"\"\<Series 2T\>\"", ",", "m2"}], "]"}], ",", 
               RowBox[{"row", "[", 
                RowBox[{"\"\<Voltage-matched 2T (VMM)\>\"", ",", "mm"}], 
                "]"}], ",", "\n", "    ", 
               RowBox[{"{", 
                
                RowBox[{"\"\<Three-terminal (3T)\>\"", ",", "na", ",", "na", ",",
                  "na", ",", 
                 RowBox[{"N", "[", 
                  RowBox[{"summ", "[", 
                   RowBox[{"[", 
                    RowBox[{"4", ",", "3"}], "]"}], "]"}], "]"}]}], "}"}], ",",
                "\n", "    ", 
               RowBox[{"{", 
                
                RowBox[{"\"\<Four-terminal (4T)\>\"", ",", "na", ",", "na", ",",
                  "na", ",", 
                 RowBox[{"N", "[", 
                  RowBox[{"summ", "[", 
                   RowBox[{"[", 
                    RowBox[{"5", ",", "3"}], "]"}], "]"}], "]"}]}], "}"}]}], 
              "}"}], ",", "headers"}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"portHeaders", "=", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Configuration / port\>\"", ",", "\"\<Voc (V)\>\"", 
             ",", "\"\<Jsc (mA/cm^2)\>\"", ",", "\"\<FF (%)\>\"", ",", "\n", 
             "    ", "\"\<Port peak PCE (%)\>\"", 
             ",", "\"\<Other external port fixed (V)\>\"", 
             ",", "\"\<Condition / status\>\""}], "}"}]}], ";", "\n", "  ", 
          RowBox[{"portRows", "=", 
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"{", "\n", "    ", 
              RowBox[{
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"row", "[", 
                  RowBox[{"\"\<3T / QIBC (TZ)\>\"", ",", "m3p"}], "]"}], ",", 
                 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"report", "[", "\"\<ThreeTerminalMPP\>\"", "]"}], 
                    "[", "\"\<PortVoltages_V\>\"", "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "\n", "      ", 
                   RowBox[{"\"\<V(ZR) fixed; conditional port peak. \>\"", "<>", 
                    RowBox[{"m3p", "[", "\"\<Status\>\"", "]"}]}]}], "}"}]}], 
                "]"}], ",", "\n", "    ", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"row", "[", 
                  RowBox[{"\"\<3T / IBC (ZR)\>\"", ",", "m3s"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"report", "[", "\"\<ThreeTerminalMPP\>\"", "]"}], 
                    "[", "\"\<PortVoltages_V\>\"", "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", "\n", "      ", 
                   RowBox[{"\"\<V(TZ) fixed; conditional port peak. \>\"", "<>", 
                    RowBox[{"m3s", "[", "\"\<Status\>\"", "]"}]}]}], "}"}]}], 
                "]"}], ",", "\n", "    ", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"row", "[", 
                  RowBox[{"\"\<4T / QIBC\>\"", ",", "m4p"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"\"\<Independent\>\"", ",", 
                   RowBox[{"\"\<Independent port. \>\"", "<>", 
                    RowBox[{"m4p", "[", "\"\<Status\>\"", "]"}]}]}], "}"}]}], 
                "]"}], ",", "\n", "    ", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"row", "[", 
                  RowBox[{"\"\<4T / IBC\>\"", ",", "m4s"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"\"\<Independent\>\"", ",", 
                   RowBox[{"\"\<Independent port. \>\"", "<>", 
                    RowBox[{"m4s", "[", "\"\<Status\>\"", "]"}]}]}], "}"}]}], 
                "]"}]}], "}"}], ",", "portHeaders"}], "]"}]}], ";", "\n", 
          "  ", 
          RowBox[{"metrics", "=", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Series2T\>\"", "->", "m2"}], ",", 
             RowBox[{"\"\<VMM\>\"", "->", "mm"}], ",", 
             RowBox[{"\"\<3T_QIBC\>\"", "->", "m3p"}], ",", 
             RowBox[{"\"\<3T_IBC\>\"", "->", "m3s"}], ",", "\n", "    ", 
             RowBox[{"\"\<4T_QIBC\>\"", "->", "m4p"}], ",", 
             RowBox[{"\"\<4T_IBC\>\"", "->", "m4s"}]}], "|>"}]}], ";", "\n", 
          "  ", 
          RowBox[{"notes", "=", 
           RowBox[{"{", "\n", "    ", 
            RowBox[{
             
             RowBox[{"\"\<PCE uses the saved incident irradiance \>\"", "<>", 
              
              RowBox[{"ToString", "[", 
               RowBox[{"InputForm", "[", "g", "]"}], "]"}], 
              "<>", "\"\< W/m^2 and the common tandem aperture. The \
bottom-port denominator is the full incident tandem power, not \
transmitted-only power.\>\""}], ",", "\n", 
             "    ", "\"\<Overall 3T and 4T Voc, Jsc and FF are not unique \
without a loading constraint; N/A means not uniquely defined, not zero. \
Tandem PCE is taken from the original joint-maximum / independent-maxima \
calculation.\>\"", ",", "\n", 
             "    ", "\"\<3T port values are conditional on the other \
EXTERNAL port voltage shown in the table. Port peak PCE is the maximum of \
that port's own power along the specified sweep. These two conditional 3T \
port peaks generally cannot be added to obtain the tandem PCE.\>\"", ",", 
             "\n", "    ", "\"\<For the independent 4T model, the two port \
peak PCEs add to the 4T tandem PCE. Their voltages, currents and fill factors \
are not added.\>\"", ",", "\n", 
             "    ", "\"\<FF[%] = 100 Pmax[W/m^2] / (10 Voc[V] Jsc[mA/cm^2]); \
PCE[%] = 100 Pmax / incident irradiance. Tables use the saved report, not any \
later global parameter changes.\>\"", ",", "\n", 
             "    ", "\"\<No endpoint extrapolation is used. If a saved sweep \
lacks V=0 or J=0, the corresponding endpoint and FF are marked unavailable. \
Reaching an interior port peak does not imply both endpoints were \
sampled.\>\"", ",", "\n", 
             "    ", "\"\<The inherited full 2T curve continues the original \
equations into reverse bias without a breakdown model. Its Jsc and FF \
therefore depend on that unvalidated model extension.\>\"", ",", "\n", 
             "    ", "\"\<Table precision is display formatting only; CSV \
values are exported without NumberForm rounding. Reference for 3T/4T \
reporting: https://doi.org/10.1021/acsenergylett.0c00068\>\""}], "\n", "  ", 
            "}"}]}], ";", "\n", "  ", 
          RowBox[{
           RowBox[{"format", "[", 
            RowBox[{"z_", "?", "NumberQ"}], "]"}], " ", ":=", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"N", "[", "z", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"12", ",", "4"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{
           RowBox[{"format", "[", "_Missing", "]"}], " ", ":=", " ", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<N/A: outside sweep\>\"", ",", 
             RowBox[{"GrayLevel", "[", "0.35", "]"}]}], "]"}]}], ";", "\n", 
          "  ", 
          RowBox[{
           RowBox[{"format", "[", "z_", "]"}], " ", ":=", " ", "z"}], ";", 
          "\n", "  ", 
          RowBox[{
           RowBox[{"grid", "[", "rows_", "]"}], " ", ":=", " ", 
           RowBox[{"Grid", "[", 
            RowBox[{
             RowBox[{"Prepend", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"format", " ", "/@", " ", "#"}], "&"}], " ", "/@", 
                 " ", 
                 RowBox[{"Rest", "[", "rows", "]"}]}], ")"}], ",", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{"#", ",", "Bold"}], "]"}], "&"}], " ", "/@", " ", 
                 RowBox[{"First", "[", "rows", "]"}]}], ")"}]}], "]"}], ",", 
             "\n", "    ", 
             RowBox[{"Frame", "->", "All"}], ",", 
             RowBox[{"Alignment", "->", "Left"}], ",", 
