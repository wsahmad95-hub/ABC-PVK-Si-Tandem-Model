         "\[IndentingNewLine]", 
        RowBox[{"ivSi", "=", 
         RowBox[{"Interpolation", "[", "dSi", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
