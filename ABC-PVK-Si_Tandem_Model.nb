             RowBox[{"v", ",", 
              RowBox[{"Eg1", "-", "0.2"}]}], "}"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"jscSi", " ", "=", " ", 
         RowBox[{"ivSi", "[", "0", "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Make", " ", "JV", " ", "characteristic", " ", "of", " ", 
