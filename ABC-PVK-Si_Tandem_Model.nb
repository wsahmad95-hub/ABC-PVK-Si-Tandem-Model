              "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"vocPe3", ",", "0."}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ivSi3", "=", 
         RowBox[{"Interpolation", "[", 
          RowBox[{"dSi3", ",", 
           RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ivPe3", "=", 
         RowBox[{"Interpolation", "[", 
          RowBox[{"dPe3", ",", 
           RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"jSi", "[", 
          RowBox[{"v_", "?", "NumericQ"}], "]"}], ":=", 
         RowBox[{"ivSi3", "[", 
          RowBox[{"Clip", "[", 
           RowBox[{"v", ",", 
            RowBox[{"{", 
             RowBox[{"0.", ",", "vocSi3"}], "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"jPe", "[", 
          RowBox[{"v_", "?", "NumericQ"}], "]"}], ":=", 
         RowBox[{"ivPe3", "[", 
          RowBox[{"Clip", "[", 
           RowBox[{"v", ",", 
            RowBox[{"{", 
             RowBox[{"0.", ",", "vocPe3"}], "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Convert", " ", "ohm", " ", 
          RowBox[{"cm", "^", "2"}], " ", "to", " ", "ohm", " ", 
          RowBox[{"m", "^", "2"}]}], "*)"}], 
        RowBox[{"r", "=", 
         RowBox[{"Rz", "*", "0.0001"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Total", " ", "extracted", " ", "power", " ", 
          RowBox[{"density", ".", "vp"}], " ", "and", " ", "vs", " ", "are", " ",
           "subcell", " ", "voltages", " ", "before", " ", "the", " ", 
          "added", " ", "Rz", " ", 
          RowBox[{"drop", ".", "The"}], " ", "shared", " ", "lead", " ", 
          "carries", " ", "the", " ", "difference", " ", "of", " ", "subcell",
           " ", 
          RowBox[{"currents", "."}]}], "*)"}], 
        RowBox[{
         RowBox[{"power3", "[", 
          RowBox[{
           RowBox[{"vp_", "?", "NumericQ"}], ",", 
           RowBox[{"vs_", "?", "NumericQ"}]}], "]"}], ":=", 
         RowBox[{
          RowBox[{"vp", "*", 
           RowBox[{"jPe", "[", "vp", "]"}]}], "+", 
          RowBox[{"vs", "*", 
           RowBox[{"jSi", "[", "vs", "]"}]}], "-", 
          RowBox[{"r", "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"jPe", "[", "vp", "]"}], "-", 
              RowBox[{"jSi", "[", "vs", "]"}]}], ")"}], "^", "2"}]}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Maximize", " ", "total", " ", 
           RowBox[{"efficiency", ".", "Both"}], " ", "external", " ", 
           "output"}], "-", 
          RowBox[{"port", " ", "voltages", " ", "must", " ", "be", " ", 
           RowBox[{"nonnegative", "."}]}]}], "*)"}], 
        RowBox[{"solution", "=", 
         RowBox[{"NMaximize", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"100", "*", 
              RowBox[{
               RowBox[{"power3", "[", 
                RowBox[{"vp", ",", "vs"}], "]"}], "/", "PowerofSun"}]}], ",", 
             
             RowBox[{
              RowBox[{"0", "<=", "vp", "<=", "vocPe3"}], "&&", 
              RowBox[{"0", "<=", "vs", "<=", "vocSi3"}], "&&", 
              RowBox[{
               RowBox[{"vp", "-", 
                RowBox[{"r", "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"jPe", "[", "vp", "]"}], "-", 
                   RowBox[{"jSi", "[", "vs", "]"}]}], ")"}]}]}], ">=", "0"}], 
              "&&", 
              RowBox[{
               RowBox[{"vs", "+", 
                RowBox[{"r", "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"jPe", "[", "vp", "]"}], "-", 
                   RowBox[{"jSi", "[", "vs", "]"}]}], ")"}]}]}], ">=", 
               "0"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"vp", ",", "vs"}], "}"}], ",", 
           RowBox[{"Method", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<DifferentialEvolution\>\"", ",", 
              RowBox[{"\"\<RandomSeed\>\"", "->", "17"}]}], "}"}]}], ",", 
