   StyleBox["*)", "Text"]}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SQFour", "[", 
     RowBox[{"Eg1_", ",", "Eg2_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Quiet", "[", 
      RowBox[{"{", "\[IndentingNewLine]", "\[IndentingNewLine]", 
