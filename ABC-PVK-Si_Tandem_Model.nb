           RowBox[{"AccuracyGoal", "->", "8"}], ",", 
           RowBox[{"PrecisionGoal", "->", "7"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"solution", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], ";"}]}]}]], "Input",
