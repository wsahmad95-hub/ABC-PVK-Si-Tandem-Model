Cell[CellGroupData[{

Cell["Silicon solar cell", "Chapter",
 CellChangeTimes->{{3.6884631396964817`*^9, 3.688463152863798*^9}, {
   3.6966792027113028`*^9, 3.6966792060636377`*^9}, 3.699851611781974*^9, {
   3.7106461730856934`*^9, 3.710646174325321*^9}, {3.710650063085187*^9, 
   3.710650065604187*^9}, {3.710741479913168*^9, 
   3.7107414888220587`*^9}},ExpressionUUID->"3b90fbf2-d7d1-4a2f-8a45-\
b8a3ed1084ea"],

Cell["\<\
The Si solar cell is modeled by fitting the current-voltage characteristics \
of a 27.4% efficient heterojunction interdigitated back-contact Silicon solar \
cell. The EQE of the Si solar cell is used to account for optical losses and \
parasitic absorption. The data for the JV curve and for the EQE are from M. \
A. Green  et al. Solar Cell Efficiency Tables (Version 67). Prog. \
Photovoltaics Res. Appl. 2026, 34, 482-496, DOI: \
https://doi.org/10.1002/pip.70068.\
\>", "Text",
 CellChangeTimes->{{3.7106480070031867`*^9, 3.710648067501187*^9}, {
  3.7106500902591867`*^9, 3.7106501665181866`*^9}, {3.710650363403187*^9, 
  3.7106503851541867`*^9}, {3.710650416696187*^9, 3.7106504206481867`*^9}, {
  3.710650738852187*^9, 3.710650777460187*^9}, {3.984464691325077*^9, 
  3.984464704060936*^9}},ExpressionUUID->"3c9ee8c6-83bd-a349-a915-\
993f791f978e"],

