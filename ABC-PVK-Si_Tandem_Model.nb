        RowBox[{"i", ",", 
         RowBox[{"EQEPerovskite", "[", "i", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1.45", ",", "1.75", ",", "0.01"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fit", "=", 
     RowBox[{"FindFit", "[", 
      RowBox[{"data", ",", 
       RowBox[{"model", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x0", ",", "sigma"}], "}"}], ",", "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gam", "=", "0."}], ";"}]}]}]], "Input",
