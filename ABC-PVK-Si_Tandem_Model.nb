       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"dPerovskite", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"v1", ",", 
             RowBox[{
              RowBox[{"FindRoot", "[", 
               RowBox[{
                RowBox[{"Il", "\[Equal]", 
                 RowBox[{"jgPerovskite", "-", "\[IndentingNewLine]", 
                  RowBox[{"JRPerovskite", "[", 
                   RowBox[{"v1", ",", "Il", ",", "RsPerovskite"}], "]"}], "-",
                   "\[IndentingNewLine]", 
                  RowBox[{"JRnonPerovskite", "[", 
                   RowBox[{"v1", ",", "Il", ",", "RsPerovskite"}], "]"}], "-",
