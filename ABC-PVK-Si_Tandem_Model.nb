Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Three", "-", 
    RowBox[{"terminal", " ", "tandem"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Rz", ":", 
     RowBox[{
      RowBox[{"additional", " ", "shared"}], "-", 
      RowBox[{"terminal", " ", "resistance", " ", "in", " ", "ohm", " ", 
       RowBox[{"cm", "^", "2."}], " ", "Current", " ", "densities"}]}], ":", 
     RowBox[{"A", "/", 
      RowBox[{"m", "^", "2"}]}]}], ",", 
    RowBox[{"as", " ", "in", " ", "the", " ", "original", " ", 
     RowBox[{"notebook", ".", "Perovskite"}], " ", "negative", " ", "is", " ",
      "connected", " ", "to", " ", "silicon", " ", 
     RowBox[{"positive", ".", "Two"}], " ", "independently", " ", 
     "controlled", " ", "electrical", " ", "outputs", " ", "are", " ", 
     RowBox[{"assumed", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "SQThree", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SQThree", "[", 
      RowBox[{
       RowBox[{"Eg1_", "?", "NumericQ"}], ",", 
       RowBox[{"Eg2_", "?", "NumericQ"}], ",", 
       RowBox[{"Rz_", ":", "0."}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "fSi", ",", "fPe", ",", "vocSi3", ",", "vocPe3", ",", "dSi3", ",", 
         "dPe3", ",", "ivSi3", ",", "ivPe3", ",", "jSi", ",", "jPe", ",", 
         "power3", ",", "r", ",", "v", ",", "j", ",", "vp", ",", "vs", ",", 
         "solution"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "Check", " ", "that", " ", "the", " ", "existing", " ", "model", " ", 
         "inputs", " ", "are", " ", "available"}], "*)"}], 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", 
            RowBox[{"And", "@@", 
             RowBox[{"(", 
              RowBox[{"NumericQ", "/@", 
               RowBox[{"{", 
                RowBox[{
                "PowerofSun", ",", "jgSitandem", ",", "jgPerovskitetandem", ",",
                  "Rz"}], "}"}]}], ")"}]}]}], "||", 
           RowBox[{"!", 
            RowBox[{"TrueQ", "[", 
             RowBox[{
              RowBox[{"PowerofSun", ">", "0"}], "&&", 
              RowBox[{"jgSitandem", ">", "0"}], "&&", 
              RowBox[{"jgPerovskitetandem", ">", "0"}], "&&", 
              RowBox[{"Rz", ">=", "0"}]}], "]"}]}]}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Silicon", " ", "current"}], "-", 
          RowBox[{"balance", " ", "equation"}]}], "*)"}], 
        RowBox[{
         RowBox[{"fSi", "[", 
          RowBox[{
           RowBox[{"v_", "?", "NumericQ"}], ",", 
           RowBox[{"j_", "?", "NumericQ"}]}], "]"}], ":=", 
         RowBox[{"j", "-", "jgSitandem", "+", 
          RowBox[{"JRSi", "[", 
           RowBox[{"v", ",", "j", ",", "1", ",", "RsSi"}], "]"}], "+", 
          RowBox[{"JRAuger", "[", 
           RowBox[{"v", ",", "j", ",", "RsSi"}], "]"}], "+", 
          RowBox[{"JRnonSi", "[", 
           RowBox[{"v", ",", "j", ",", "RsSi"}], "]"}], "+", 
          RowBox[{"Resistance", "[", 
           RowBox[{"v", ",", "j", ",", "RsSi", ",", "RshSi"}], "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Perovskite", " ", "current"}], "-", 
          RowBox[{"balance", " ", "equation"}]}], "*)"}], 
        RowBox[{
         RowBox[{"fPe", "[", 
          RowBox[{
           RowBox[{"v_", "?", "NumericQ"}], ",", 
           RowBox[{"j_", "?", "NumericQ"}]}], "]"}], ":=", 
         RowBox[{"j", "-", "jgPerovskitetandem", "+", 
          RowBox[{"JRPerovskite", "[", 
           RowBox[{"v", ",", "j", ",", "2", ",", "RsPerovskite"}], "]"}], "+", 
          RowBox[{"JRnonPerovskite", "[", 
           RowBox[{"v", ",", "j", ",", "RsPerovskite"}], "]"}], "+", 
          RowBox[{"Resistance", "[", 
           RowBox[{"v", ",", "j", ",", "RsPerovskite", ",", "RshPerovskite"}],
            "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Calculate", " ", "individual", " ", "subcell", " ", "open"}], "-", 
          
          RowBox[{"circuit", " ", "voltages"}]}], "*)"}], 
        RowBox[{"vocSi3", "=", 
         RowBox[{"v", "/.", " ", 
          RowBox[{"FindRoot", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"fSi", "[", 
              RowBox[{"v", ",", "0."}], "]"}], "==", "0"}], ",", 
            RowBox[{"{", 
             RowBox[{"v", ",", "0.", ",", 
              RowBox[{"N", "[", "Eg1", "]"}]}], "}"}], ",", 
            RowBox[{"Method", "->", "\"\<Brent\>\""}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vocPe3", "=", 
         RowBox[{"v", "/.", " ", 
          RowBox[{"FindRoot", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"fPe", "[", 
              RowBox[{"v", ",", "0."}], "]"}], "==", "0"}], ",", 
            RowBox[{"{", 
             RowBox[{"v", ",", "0.", ",", 
              RowBox[{"N", "[", "Eg2", "]"}]}], "}"}], ",", 
            RowBox[{"Method", "->", "\"\<Brent\>\""}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Make", " ", "JV", " ", "characteristic", " ", "of", " ", "the", " ",
           "silicon", " ", "bottom", " ", "cell"}], "*)"}], 
        RowBox[{"dSi3", "=", 
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"v", ",", 
               RowBox[{"j", "/.", " ", 
                RowBox[{"FindRoot", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"fSi", "[", 
                    RowBox[{"v", ",", "j"}], "]"}], "==", "0"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"j", ",", "0.", ",", 
                    RowBox[{"N", "[", "jgSitandem", "]"}]}], "}"}], ",", 
                  RowBox[{"Method", "->", "\"\<Brent\>\""}]}], "]"}]}]}], 
              "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"v", ",", 
               RowBox[{"Most", "[", 
                RowBox[{"Subdivide", "[", 
                 RowBox[{"0.", ",", "vocSi3", ",", 
                  RowBox[{"Ceiling", "[", 
                   RowBox[{"vocSi3", "/", "0.001"}], "]"}]}], "]"}], "]"}]}], 
              "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"vocSi3", ",", "0."}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Make", " ", "JV", " ", "characteristic", " ", "of", " ", "the", " ",
           "perovskite", " ", "top", " ", "cell"}], "*)"}], 
        RowBox[{"dPe3", "=", 
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"v", ",", 
               RowBox[{"j", "/.", " ", 
                RowBox[{"FindRoot", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"fPe", "[", 
                    RowBox[{"v", ",", "j"}], "]"}], "==", "0"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"j", ",", "0.", ",", 
                    RowBox[{"N", "[", "jgPerovskitetandem", "]"}]}], "}"}], ",", 
                  RowBox[{"Method", "->", "\"\<Brent\>\""}]}], "]"}]}]}], 
              "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"v", ",", 
               RowBox[{"Most", "[", 
                RowBox[{"Subdivide", "[", 
                 RowBox[{"0.", ",", "vocPe3", ",", 
                  RowBox[{"Ceiling", "[", 
